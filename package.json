  "scripts": {
    "build": "tsdown",
    "clean": "node scripts/clean.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "drift:report": "node scripts/drift-report.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "format": "oxfmt --write package.json tsconfig.json tsconfig.examples.json tsconfig.test.json tsdown.config.ts vitest.config.ts .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml src/index.ts src/operations.ts src/client scripts tests .github README.md CHANGELOG.md",
    "format:check": "oxfmt --check package.json tsconfig.json tsconfig.examples.json tsconfig.test.json tsdown.config.ts vitest.config.ts .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml src/index.ts src/operations.ts src/client scripts tests .github README.md CHANGELOG.md",
    "generate": "node scripts/generate/source.mjs",
    "generate:check": "node scripts/generate/check.mjs",
    "generate:source:refresh": "node scripts/generate/source.mjs --refresh-snapshot",
    "lint": "oxlint --type-aware --deny-warnings src/index.ts src/operations.ts src/client scripts tests tsdown.config.ts vitest.config.ts",
    "package:check": "node scripts/check-package.mjs",
    "package:budgets:refresh": "pnpm build && node scripts/inspect-pack.mjs --refresh-budgets",
    "pack:inspect": "node scripts/inspect-pack.mjs",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm validate",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "validate": "pnpm generate:check && pnpm docs:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm examples:check && pnpm build && pnpm run package:check -- --built"
  },
  "devDependencies": {
