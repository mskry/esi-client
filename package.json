    "@bybrave/fast-json-patch2": "4.0.0",
    "@scalar/openapi-parser": "0.28.14",
    "@types/node": "22.18.0",
    "es-module-lexer": "2.3.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
